+extern volatile uchar usbTxLen;
+
+// Midimalism patch: flash writes switch interrupts off for 4.5 ms per page,
+// so the device can't answer USB meanwhile. The original code waited a fixed
+// 2 ms for the host to finish the USB transfer that triggered the write; on
+// some hosts (Apple Silicon USB-C ports) the transfer wasn't done by then and
+// failed. Instead, wait until the driver has handed the transfer's last
+// packet (status stage or reply) to the host, then a little longer for the
+// host's handshake. Gives up after 20 ms, then writes anyway.
+static void waitForUsbTransferEnd(void)
+{
+    uint8_t i;
+    for(i = 0; i < 200 && usbTxLen != USBPID_NAK; i++)
+        _delay_us(100);
+    _delay_us(500);
 }
 
